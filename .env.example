# NextAuth / Auth.js Configuration
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
AUTH_SECRET="your-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Database (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# API Backend URL (Next.js gọi C# Backend)
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Backend C# .NET 9 Secrets
JWT_SECRET_KEY="your-jwt-secret-key-min-32-chars"
GEMINI_API_KEY="AIzaSy..."
EMAIL_PASSWORD="gmail-app-password"
RESEND_API_KEY="re_123456789..."
ORDER_NOTIFICATION_EMAIL="sales@hdcfashion.vn"

