# ==================================================
# HUNI BACKEND (.NET 9) — Production Environment Variables
# ==================================================

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Connection String (Supabase / Managed Postgres)
# Tip: Use URL format if password contains special characters (; @ = #)
ConnectionStrings__DefaultConnection="Host=db.qyocmpfyquxutozlokpi.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_STRONG_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=20;Minimum Pool Size=2;Connection Idle Lifetime=300"

# JWT Authentication (Minimum 256-bit / 64-byte Base64 key)
Jwt__SecretKey="YOUR_GENERATED_64_BYTE_BASE64_SECRET"
Jwt__Issuer="HuniBackend"
Jwt__Audience="HuniClient"
Jwt__ExpiresInDays=30

# CORS Allowed Origins
Cors__AllowedOrigins__0="https://hunistore.com"
Cors__AllowedOrigins__1="https://www.hunistore.com"
Cors__AllowedOrigins__2="https://hunistore.vercel.app"

# Google Gemini AI Integration
Gemini__ApiKey="AIzaSy..."
Gemini__ModelId="gemini-2.5-flash"

# SMTP Email Service
Email__SmtpHost="smtp.gmail.com"
Email__SmtpPort=587
Email__FromEmail="noreply@hunistore.com"
Email__Password="YOUR_GMAIL_APP_PASSWORD"
Email__AdminEmail="admin@hunistore.com"

# Rate Limiting
RateLimit__OrdersPerHour=5
