                  className={`w-4 h-4 shrink-0 transition-transform ${
                    isActive
                      ? "text-white"
                      : "text-slate-400 group-hover:text-blue-400"
                  }`}
                />
                <span>{item.label}</span>
              </div>

              <div className="flex items-center gap-1.5">
                {badgeCount > 0 && (
                  <span
