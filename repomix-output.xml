                    }`}
                  >
                    {pos.label}
                  </button>
                ))}
              </div>
            </div>

            {/* 3. Logo upload or text */}
            <div>
              <div className="flex items-center justify-between mb-2 gap-2">
                <label className="text-[11px] sm:text-xs font-bold text-slate-700">
                  3. Logo doanh nghiệp:
