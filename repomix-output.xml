                          <span>{feat}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              {/* Nút Đặt hàng ngay (Client CTA) */}
              <ProductDetailOrderCTA product={product} />

              {/* Thông tin dịch vụ & chính sách */}
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-200 text-xs">
