      size: selectedSize,
    });
    setQuickViewProduct(null);
    setIsCartOpen(true);
    triggerConfetti();
  };

  const handleOpenCustomizer = () => {
    setCustomizerProduct(product);
    setIsCustomizerOpen(true);
  };

  const handlePrevImage = () => {
