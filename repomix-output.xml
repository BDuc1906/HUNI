          title={isFavorite ? "Đã yêu thích" : "Lưu vào yêu thích"}
        >
          <Heart className={`w-3.5 h-3.5 sm:w-4 sm:h-4 ${isFavorite ? "fill-current text-rose-500" : ""}`} />
