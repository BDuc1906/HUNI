    focusMobile: "center 22%",
    focusDesktop: "center 25%",
    eyebrow: "Dòng Sản Phẩm Trẻ Em",
    title: "ĐỒNG PHỤC HDC KIDS",
    titleHighlight: "VUI NHỘN & AN TOÀN",
