  // ============================================================
  // CHỈ LẤY SP CÓ FLAG isNewArrival: true
  // KHÔNG fallback lấy cuối mảng
  // ============================================================
  const newArrivals = PRODUCTS.filter((p) => p.isNewArrival === true).slice(
    0,
