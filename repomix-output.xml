                  />
                </div>

                <div className="sm:col-span-2">
                  <label className="font-bold text-slate-700 block mb-1">
                    Địa chỉ nhận hàng / Lấy số đo văn phòng <span className="text-rose-500">*</span>:
                  </label>
                  <input
