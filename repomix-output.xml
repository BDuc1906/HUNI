          status: "Đang sản xuất tại chuyền may",
          currentStep: 3,
          total: 8500000,
          items: [
            {
              product: { title: "Áo Polo Doanh Nghiệp HUNI Classic Gold" },
              quantity: 50,
              color: "Xanh Navy Hoàng Gia",
              size: "Size L (25 áo), Size M (25 áo)"
