                        : "Giặt máy ≤40°C, phơi nơi thoáng, không phơi trực tiếp nắng gắt"}
                    </div>
                  )}
                </div>

                {/* Tab 3: Chính sách */}
                <div>
                  <button
                    type="button"
                    onClick={() => setOpenTab(openTab === "policy" ? null : "policy")}
