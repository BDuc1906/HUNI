        body: JSON.stringify({ fullName, email, phone, password }),
      });

      const data = await res.json();

      if (!data.success) {
        const details = data.details
          ?.map((d) => d.message)
          .join(" | ");
        setError(details ? `${data.error} — ${details}` : data.error);
        return;
      }

      router.push("/login?registered=1");
