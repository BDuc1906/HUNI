          <h2 className="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-extrabold text-[#071b34]">
            DANH MỤC SẢN PHẨM ĐỒNG PHỤC HUNI
          </h2>
          <p className="text-slate-600 text-xs sm:text-sm md:text-base">
