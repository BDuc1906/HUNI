          title="Yêu Cầu Báo Giá"
          value={totalQuotes}
          subtext={`${newQuotes} yêu cầu mới chưa xử lý`}
          icon={FileText}
          iconBgColor="bg-amber-500/10"
          iconTextColor="text-amber-400"
          borderColor="border-amber-500/20"
        />

        {/* Khách hàng */}
        <StatsCard
          title="Khách Hàng"
          value={totalCustomers}
          subtext="Doanh nghiệp & đối tác"
          icon={Users}
