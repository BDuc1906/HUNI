                  <span className="text-slate-700 font-semibold leading-tight">
                    May mẫu 0đ
                  </span>
                </div>
              </div>
            </div>
          </div>

          {/* =========================================================
              CỘT PHẢI — Info + Config
              ========================================================= */}
