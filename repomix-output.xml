@import "tailwindcss";

/* =========================================================
   HDC FASHION — BRAND THEME (theo Catalogue 2023-12-28)
   Màu chủ đạo: Teal #0097B2 (đo trực tiếp từ logo & tiêu đề catalogue)
   Nền panel: #F6F8FF  |  Nhãn xám lam: #DADFE9  |  Chữ: đen
   Dùng class Tailwind: bg-brand-500, text-brand-600, border-brand-200 ...
   ========================================================= */
@theme {
  --color-brand-50:  #e6f6f9;
  --color-brand-100: #ccecf2;
  --color-brand-200: #99d9e5;
  --color-brand-300: #66c5d8;
  --color-brand-400: #33b0cb;
  --color-brand-500: #0097b2; /* MÀU THƯƠNG HIỆU */
  --color-brand-600: #007f96;
  --color-brand-700: #00677a;
  --color-brand-800: #004f5e;
  --color-brand-900: #003843;
  --color-brand-950: #00222a;

  --color-panel: #f6f8ff;   /* nền khung ảnh / thẻ trong catalogue */
  --color-label: #dadfe9;   /* nhãn xám lam trên ảnh sản phẩm */
}

/* ---------- Base tokens ---------- */
@layer base {
  :root {
    --bg-page: #f6f8ff;
    --bg-surface: #ffffff;
    --bg-card: #ffffff;
    --text-main: #111827;
    --text-muted: #52525b;
    --text-sub: #71717a;
    --border-color: #e4e4e7;
    --border-subtle: #f4f4f5;
  }

  .dark {
    --bg-page: #00222a;
    --bg-surface: #003843;
    --bg-card: #003843;
    --text-main: #f4f4f5;
    --text-muted: #a1a1aa;
    --text-sub: #71717a;
    --border-color: #00566a;
    --border-subtle: #003843;
  }
}

/* ---------- Scroll behavior ---------- */
html {
  scroll-behavior: smooth;
  color-scheme: light dark;
  overflow-x: hidden;
}

body {
  background-color: var(--bg-page);
  color: var(--text-main);
  overflow-x: hidden;
  /* Font self-host qua next/font — không FOUT */
  font-family: var(--font-jakarta), -apple-system, BlinkMacSystemFont,
    "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  transition: background-color 0.2s ease, color 0.2s ease;
  /* Text smoothing cho font hiển thị mượt */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* Offset cho sticky header khi scroll tới anchor */
section[id],
div[id],
main[id] {
  scroll-margin-top: 140px;
}

/* Scrollbar teal thương hiệu */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #0097b2; border-radius: 9999px; }
.dark ::-webkit-scrollbar-thumb { background: #33b0cb; }

/* =========================================================
   Custom class — Tiêu đề gradient teal (dùng trên nền tối)
   ========================================================= */
.text-brand-gradient {
  background: linear-gradient(90deg, #33b0cb 0%, #99d9e5 50%, #33b0cb 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Nhãn chữ giãn rộng kiểu "C A T A L O G U E" của catalogue */
.brand-eyebrow {
  letter-spacing: 0.4em;
  text-transform: uppercase;
  font-weight: 700;
  color: #0097b2;
}

/* =========================================================
   Mobile — chừa chỗ cho bottom action bar cố định
   ========================================================= */
@media (max-width: 767px) {
  body {
    padding-bottom: 64px;
  }

  /* Tối ưu tap target cho mobile — tránh double-tap zoom */
  button,
  a {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  /* Smooth scroll trên iOS */
  html {
    -webkit-overflow-scrolling: touch;
  }
}

/* =========================================================
   Image — chống layout shift khi ảnh đang tải
   ========================================================= */
img {
  max-width: 100%;
  height: auto;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: auto;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transform: translateZ(0);
  -webkit-interpolation-mode: bicubic;
}

/* Next.js Image wrapper không bị dãn */
[data-nimg] {
  max-width: 100%;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: auto;
  transform: translateZ(0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  -webkit-interpolation-mode: bicubic;
}

/* =========================================================
   GPU Acceleration helper - chống jagged edges khi animate
   ========================================================= */
.gpu-accelerated {
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

/* =========================================================
   Marquee Animation — Logo đối tác chạy liên tục vô tận
   ========================================================= */
@keyframes marquee-scroll {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

.animate-marquee-infinite,
.animate-marquee {
  display: flex;
  width: max-content;
  animation: marquee-scroll 26s linear infinite;
}

.animate-marquee-infinite:hover,
.animate-marquee:hover {
  animation-play-state: paused !important;
}

/* =========================================================
   Ẩn dev indicator của Next.js (nút chữ N ở góc trái dưới)
   ========================================================= */
nextjs-portal,
[data-nextjs-dev-indicator],
[data-nextjs-toast] {
  display: none !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

/* =========================================================
   HIỆU ỨNG XUẤT HIỆN CHỮ ĐA DẠNG (DIVERSE TEXT ANIMATIONS)
   ========================================================= */

/* 1. Kinetic Slide-Up Reveal (Trượt chữ từ mặt nạ cắt) */
@keyframes text-slide-up {
  0% {
    transform: translateY(115%);
    opacity: 0;
  }
  100% {
    transform: translateY(0%);
    opacity: 1;
  }
}

.animate-text-slide-up {
  animation: text-slide-up 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 2. Blur to Sharp Focus Reveal (Hội tụ nét từ mờ ảo) */
@keyframes text-blur-in {
  0% {
    filter: blur(12px);
    opacity: 0;
    transform: translateY(10px) scale(0.97);
  }
  100% {
    filter: blur(0px);
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.animate-text-blur-in {
  animation: text-blur-in 0.75s cubic-bezier(0.16, 1, 0.3, 1) both;
}

/* 3. Radiant Shimmering Gradient (Chữ phát sáng chảy tràn) */
@keyframes text-gradient-flow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

.text-brand-gradient-flow {
  background: linear-gradient(90deg, #33b0cb 0%, #99d9e5 25%, #ffffff 50%, #99d9e5 75%, #33b0cb 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: text-gradient-flow 4.5s ease-in-out infinite;
}

.text-gold-gradient-flow {
  background: linear-gradient(90deg, #f59e0b 0%, #fef3c7 25%, #ffffff 50%, #fef3c7 75%, #f59e0b 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: text-gradient-flow 4.5s ease-in-out infinite;
}

/* 4. Light Sheen Wave on Badges (Vệt sáng kim loại quét qua) */
@keyframes sheen-sweep {
  0% {
    transform: translateX(-150%) skewX(-20deg);
  }
  100% {
    transform: translateX(250%) skewX(-20deg);
  }
}

.sheen-badge-overlay {
  position: relative;
  overflow: hidden;
}

.sheen-badge-overlay::after {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.4) 50%,
    transparent 100%
  );
  animation: sheen-sweep 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  pointer-events: none;
}

/* 5. Vệt sáng kim loại 45 độ quét qua mượt mà (Metallic Sheen Sweep 45deg) */
@keyframes metallic-sweep-45 {
  0% {
    transform: translate3d(-120%, -120%, 0) rotate(45deg);
    opacity: 0;
  }
  12% {
    opacity: 1;
  }
  50% {
    transform: translate3d(120%, 120%, 0) rotate(45deg);
    opacity: 1;
  }
  60%, 100% {
    transform: translate3d(150%, 150%, 0) rotate(45deg);
    opacity: 0;
  }
}

.metallic-sheen-container {
  position: relative;
  overflow: hidden;
}

.metallic-sheen-container::after {
  content: "";
  position: absolute;
  top: -70%;
  left: -70%;
  width: 240%;
  height: 240%;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.03) 30%,
    rgba(255, 255, 255, 0.5) 50%,
    rgba(255, 255, 255, 0.03) 70%,
    transparent 100%
  );
  transform: translate3d(-120%, -120%, 0) rotate(45deg);
  animation: metallic-sweep-45 4s cubic-bezier(0.25, 1, 0.5, 1) infinite;
  pointer-events: none;
  z-index: 25;
}
