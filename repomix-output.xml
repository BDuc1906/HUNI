                {/* Badge */}
                {product.badge && (
                  <div className="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-[#071b34] text-amber-300 font-bold text-[10px] sm:text-[11px] border border-amber-400/40 shadow-lg">
                    {product.badge}
                  </div>
                )}

                {/* Nav ảnh */}
                {gallery.length > 1 && (
                  <>
                    <button
                      onClick={handlePrevImage}
