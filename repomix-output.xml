                      <div>✓ Giao hàng toàn quốc, theo dõi đơn realtime</div>
                    </div>
                  )}
                </div>
              </div>

              {/* Đánh giá & Phản hồi thực tế (Prompt C) */}
              <Suspense
                fallback={
