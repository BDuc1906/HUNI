            <div>
              <label className="text-xs font-bold text-slate-700 block mb-2">
                1. Chọn Công Nghệ In / Thêu:
              </label>
              <div className="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  onClick={() => setMethod("theu_vi_tinh")}
